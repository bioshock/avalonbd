ADMIN_EMAIL=admin@avalonbd.com
ADMIN_PASSWORD=change-me-now
# Admin JSON API (docs/api.md). Leave empty to disable. At least 32 characters:
#   openssl rand -hex 32
ADMIN_API_TOKEN=
